{
  "name": "job-log",
  "version": "1.0.0",
  "private": true,
  "description": "Job Log — to-do list with a dated Done log, synced between Android and desktop",
  "scripts": {
    "build": "esbuild src/app.js --bundle --minify --format=esm --target=es2019 --loader:.woff2=file --loader:.woff=file --asset-names=fonts/[name]-[hash] --outdir=www --entry-names=app"
  },
  "dependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "6.2.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/local-notifications": "6.1.3",
    "@capacitor/status-bar": "^6.0.3",
    "@capgo/capacitor-native-biometric": "^6.0.4",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "firebase": "10.14.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "esbuild": "0.23.1"
  }
}
